{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "Last Comment",
  "version": "1.0.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "homepage_url": "https://github.com/eddy961206/github-last-comment-chrome-extension",
  "permissions": ["storage"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_title": "Last Comment for GitHub",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_scripts": [{
    "matches": ["https://github.com/*"],
    "js": ["src/shared.js", "src/styles.js", "src/parser.js", "src/render.js", "src/transport.js", "src/content.js"],
    "run_at": "document_idle",
    "all_frames": false,
    "world": "ISOLATED"
  }],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
